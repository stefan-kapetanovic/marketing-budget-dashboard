        function initHeatmap() {
            const container = document.getElementById('heatmap-container');
            if(container.children.length > 13) return; // Already initialized

            const regions = ['Europe', 'Asia', 'N. America', 'S. America', 'Middle East'];
            
            regions.forEach((region, rIdx) => {
                // Row header
                const label = document.createElement('div');
                label.className = 'heatmap-label text-left justify-start pl-2';
                label.textContent = region;
                // Add delay for stagger effect
                label.style.animation = `fadeRight 0.5s ease-out ${rIdx * 0.1}s both`;
                container.appendChild(label);

                // Generate cells for 12 months
                for(let m=0; m<12; m++) {
                    const cell = document.createElement('div');
                    
                    let basePrice = 50;
                    if(region === 'Asia') basePrice = 45;
                    if(region === 'N. America') basePrice = 55;
                    if(region === 'S. America' || region === 'Middle East') basePrice = 65;
                    
                    const price = Math.round(basePrice + (Math.sin(m/2) * 5) + (Math.random()*10 - 5));
                    const normalized = Math.max(0, Math.min(1, (price - 40) / 40));
                    
                    let r, g, b;
                    if (normalized < 0.5) {
                        r = 15; g = 23 + (160 * (normalized*2)); b = 42 + (120 * (normalized*2));
                    } else {
                        const n2 = (normalized - 0.5) * 2;
                        r = 15 + (220 * n2); g = 183 - (140 * n2); b = 162 - (130 * n2);
                    }

                    cell.className = 'heatmap-cell opacity-0';
                    cell.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
                    cell.style.color = normalized > 0.6 || normalized < 0.2 ? 'white' : 'black';
                    cell.textContent = `€${price}`;
                    
                    // Cascade fade in animation
                    setTimeout(() => {
                        cell.style.transition = 'opacity 0.5s ease-in, transform 0.2s';
                        cell.classList.remove('opacity-0');
                    }, 500 + (rIdx * 100) + (m * 50));
                    
                    // Tooltip
                    const tooltip = document.createElement('span');
                    tooltip.className = 'tooltiptext';
                    tooltip.textContent = `${region} - ${months24[m]}: €${price}`;
                    cell.appendChild(tooltip);

                    container.appendChild(cell);
                }
            });
        }

        function initChart10() {
            if(charts.chart10) return;
            const ctx = document.getElementById('chart-bubble').getContext('2d');
            charts.chart10 = new Chart(ctx, {
