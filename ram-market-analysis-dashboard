                        { label: 'SK Hynix', data: [{ x: 48, y: 950, r: 32 }], backgroundColor: 'rgba(6, 182, 212, 0.6)', borderColor: '#06b6d4', borderWidth: 2, hoverBorderWidth: 4, hoverBackgroundColor: 'rgba(6, 182, 212, 0.8)' },
                        { label: 'Micron', data: [{ x: 45, y: 650, r: 24 }], backgroundColor: 'rgba(20, 184, 166, 0.6)', borderColor: '#14b8a6', borderWidth: 2, hoverBorderWidth: 4, hoverBackgroundColor: 'rgba(20, 184, 166, 0.8)' },
                        { label: 'Kingston', data: [{ x: 38, y: 350, r: 16 }], backgroundColor: 'rgba(99, 102, 241, 0.6)', borderColor: '#6366f1', borderWidth: 2, hoverBorderWidth: 4, hoverBackgroundColor: 'rgba(99, 102, 241, 0.8)' },
                        { label: 'Corsair', data: [{ x: 68, y: 250, r: 20 }], backgroundColor: 'rgba(139, 92, 246, 0.6)', borderColor: '#8b5cf6', borderWidth: 2, hoverBorderWidth: 4, hoverBackgroundColor: 'rgba(139, 92, 246, 0.8)' }
