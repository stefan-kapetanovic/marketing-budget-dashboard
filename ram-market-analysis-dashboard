        function animateGauges() {
            const circles = document.querySelectorAll('.gauge-path');
            circles.forEach(circle => {
                if(!circle.classList.contains('animate')) {
                    circle.classList.add('animate');
                }
            });
        }

        
        // Scroll Progress Bar
        window.addEventListener('scroll', () => {
            const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
            const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (winScroll / height) * 100;
            document.getElementById('progress-bar').style.width = scrolled + '%';
            
            // Header transparency on scroll
            const header = document.getElementById('main-header');
            if (winScroll > 50) {
                header.classList.add('backdrop-blur-md', 'border-b', 'border-white/10');
            } else {
                header.classList.remove('backdrop-blur-md', 'border-b', 'border-white/10');
            }
        });

        // Intersection Observer for revealing sections and triggering charts
        const observerOptions = {
            root: null,
            rootMargin: '0px',
            threshold: 0.2 // Trigger when 20% of section is visible
        };

        const sectionObserver = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    
                    // Trigger specific initialization based on section ID
                    const id = entry.target.id;
                    if (id === 'slide-2') initChart2();
                    if (id === 'slide-3') initChart3();
                    if (id === 'slide-4') initChart4();
                    if (id === 'slide-5') initChart5();
                    if (id === 'slide-6') initChart6();
                    if (id === 'slide-7') initChart7();
                    if (id === 'slide-8') initChart8();
                    if (id === 'slide-9') initHeatmap();
                    if (id === 'slide-10') initChart10();
                    if (id === 'slide-11') initChart11();
                    if (id === 'slide-12') initChart12();
                    if (id === 'slide-13') animateGauges();

                    // Optional: Unobserve if we only want to animate once
                    // observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        // Start observing all sections
        document.addEventListener('DOMContentLoaded', () => {
            const sections = document.querySelectorAll('.reveal-section');
            sections.forEach(sec => sectionObserver.observe(sec));
            
            // Fix initial hero section state
            document.getElementById('slide-0').querySelector('.reveal-section').classList.add('is-visible');
        });

        // Fullscreen Toggle
        function toggleFullscreen() {
            const elem = document.documentElement;
            if (!document.fullscreenElement) {
                elem.requestFullscreen().catch(err => {
                    console.log(`Error attempting to enable fullscreen: ${err.message}`);
                });
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }

        document.getElementById('btn-fullscreen').addEventListener('click', toggleFullscreen);

    </script>
